# === SERVER CONFIGURATION ===
PORT=3000
NODE_ENV=production
APP_URL=https://api.crysantem.tech
SERVE_FRONTEND=false

# === GOOGLE OAUTH CONFIGURATION ===
# IMPORTANTE: Generar nuevas credenciales en Google Cloud Console
# Usar dominio de producción en Authorized Redirect URIs
GOOGLE_CLIENT_ID=your-production-google-client-id
GOOGLE_CLIENT_SECRET=your-production-google-client-secret
GOOGLE_REDIRECT_URI=https://api.crysantem.tech/api/auth/google/callback

# === EMAIL CONFIGURATION (Brevo/Sendinblue) ===
# Generar nueva API key en Brevo Dashboard
BREVO_API_KEY=your-production-brevo-api-key
EMAIL_FROM=noreply@crysantem.tech
EMAIL_FROM_NAME=Crysantem

# === SUPABASE CONFIGURATION ===
# Usar service role key solo en backend (NUNCA en frontend)
SUPABASE_URL=https://pazpomltsuerftqgkvmq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# === SECURITY TOKENS ===
# GENERAR TOKENS SEGUROS (32+ caracteres alfanuméricos):
# Comando: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_TOKEN=generate-secure-32-character-token
N8N_WEBHOOK_SECRET=generate-secure-32-character-secret
JWT_SECRET=generate-secure-jwt-secret-min-32-chars

# === CORS CONFIGURATION ===
# IMPORTANTE: Incluir el dominio del frontend
ALLOWED_ORIGINS=https://crysantem.tech,https://www.crysantem.tech

# === N8N WEBHOOK ===
N8N_WEBHOOK_URL=https://n8n-n8n.f6ppdc.easypanel.host/webhook/agente-workflow

# === MYIA PLAN WEBHOOKS ===
# Configurar webhooks específicos por plan en n8n
WEBHOOK_RESPONDE=https://n8n-your-domain.com/webhook/myia-responde
WEBHOOK_ASISTE=https://n8n-your-domain.com/webhook/myia-asiste
WEBHOOK_AUTOMATIZA=https://n8n-your-domain.com/webhook/myia-automatiza
WEBHOOK_INTELLIGENCE=https://n8n-your-domain.com/webhook/myia-intelligence
