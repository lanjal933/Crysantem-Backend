RewriteEngine On

# No reescribir archivos estáticos (js, css, imágenes, etc.)
RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ [NC]
RewriteRule .* - [L]

# Redirigir según el slug al archivo HTML correspondiente
RewriteRule ^responde-.*$ myia-responde.html [L]
RewriteRule ^asiste-.*$ myia-asiste.html [L]
RewriteRule ^automatiza-.*$ myia-automatiza.html [L]
RewriteRule ^intelligence-.*$ myia-intelligence.html [L]

# Para todo lo demás, redirigir a myia-responde.html (por defecto)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ myia-responde.html [L,QSA]
