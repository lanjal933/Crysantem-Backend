# Configuración del Servidor
PORT=3000
NODE_ENV=production
APP_URL=https://tu-dominio.com
SERVE_FRONTEND=true

# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://tu-dominio.com/api/auth/google/callback

# Seguridad
JWT_SECRET=your-secret-key-min-32-chars
API_TOKEN=your-api-token
N8N_WEBHOOK_SECRET=your-webhook-secret

# Email (Brevo/Sendinblue)
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=noreply@tu-dominio.com
EMAIL_FROM_NAME=Crysantem

# n8n Webhooks
WEBHOOK_RESPONDE=https://tu-n8n-instance.com/webhook/responde
WEBHOOK_ASISTE=https://tu-n8n-instance.com/webhook/asiste
WEBHOOK_AUTOMATIZA=https://tu-n8n-instance.com/webhook/automatiza
WEBHOOK_INTELLIGENCE=https://tu-n8n-instance.com/webhook/intelligence

# CORS
ALLOWED_ORIGINS=https://tu-dominio.com,https://www.tu-dominio.com
